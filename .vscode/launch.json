{
    // 使用 IntelliSense 了解相关属性。 
    // 悬停以查看现有属性的描述。
    // 欲了解更多信息，请访问: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [

        {
            "name": "Python 调试程序: 当前文件",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Debug MCP Service",
            "type": "debugpy",
            "request": "launch",
            "module": "mcp_tool.main",  // 替换为你的实际模块路径
            "args": [
              "--transport", "sse",
              "--port", "8000"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
              "PYTHONPATH": "${workspaceFolder}/slines_mcp"  // 若代码在 src 目录下
            },
            "justMyCode": false  // 允许进入第三方库代码
        },
        {
            "name": "Python: 启动主服务",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "cwd": "${workspaceFolder}",       
            "console": "integratedTerminal",
            "env": {
            },            
            "args": [
                "--transport", "sse",
                "--port", "8000"
            ],
        }
    ]
}