    "version": "0.2.0",
    "configurations": [

        {
            "name": "Python 调试程序: 当前文件",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Python: 启动主服务",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "cwd": "${workspaceFolder}",       
            "console": "integratedTerminal",
            "env": {
            },
            "args": [
                "--transport", "sse",
                "--port", "8000"
            ]
        },
        {
            "name": "Python: 启动数据集MCP",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/slines_mcp/dataset.py",
            "cwd": "${workspaceFolder}/slines_mcp",       
            "console": "integratedTerminal",
            "env": {
            },
            "args": [
                "--transport", "sse",
                "--port", "8000"
            ]
        }
    ]
}